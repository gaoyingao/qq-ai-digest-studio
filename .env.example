# NapCat OneBot 11 正向 WebSocket 地址 (或者在 NapCat 中添加反向 WS: ws://127.0.0.1:3210/onebot/v11/ws)
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=
SELF_QQ_ID=

# 远程 AI 大模型 API 配置 (支持 DeepSeek / 硅基流动 / 通义千问 / Gemini / OpenAI 兼容接口)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_FAST_MODEL=deepseek-chat
LLM_MAIN_MODEL=deepseek-chat

# 控制台与手机局域网访问端口
PORT=3210
